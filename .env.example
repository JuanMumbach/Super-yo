# --- Telegram ---
# Crea un bot con @BotFather y pega el token aquí
TELEGRAM_BOT_TOKEN=123456:ABC-tu-token
# Opcional: tu chat id. Si lo dejas vacío, el primer chat que envíe /start queda registrado como dueño.
TELEGRAM_CHAT_ID=

# --- Groq (LLM rápido + Whisper) ---
GROQ_API_KEY=gsk_tu_clave
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Local ---
PORT=3000
DB_PATH=data/superyo.db
# Zona horaria para recordatorios
TZ=America/Argentina/Buenos_Aires

# --- Agente CLI (retrospectivas) ---
# Comando al que se le añade un prompt corto entre comillas como último argumento.
# Ejemplos: "opencode run"  |  "agy -p"
AGENT_CMD=opencode run
AGENT_TIMEOUT_MS=300000
